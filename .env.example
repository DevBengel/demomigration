# Copy to .env and edit; do not commit secrets.
SOURCE=axl
CUCM_HOST=198.18.133.33
CUCM_USERNAME=
CUCM_PASSWORD=
# Obtain AXLAPI.wsdl + its imported XSD files from your CUCM AXL toolkit.
CUCM_AXL_WSDL=./axl/AXLAPI.wsdl
CUCM_AXL_VERSION=14.0
CUCM_AXL_BINDING={http://www.cisco.com/AXLAPIService/}AXLAPIBinding
CUCM_VERIFY_TLS=true
# CUCM_CA_BUNDLE=./certs/cucm-ca.pem
CUCM_TIMEOUT=30
OUTPUT_DIR=./migration-output
WEBEX_ACCESS_TOKEN=
WEBEX_ORG_ID=
WEBEX_LOCATION_ID=

# v0.3: technical Hunt Group naming and reserved candidate extension pool
WEBEX_HG_PREFIX=HG
WEBEX_HG_EXTENSION_START=89000
WEBEX_HG_EXTENSION_END=89999
# IMPORTANT: extensions are unverified candidates, not Webex availability checks.

# v0.4: optional literal line prefixes, comma-separated; empty = all Hunt Pilots
CUCM_HUNT_PILOT_PREFIXES=
CUCM_HUNT_PILOT_EXCLUDE_PREFIXES=

# v0.5 Webex discovery: optional. If blank, token is requested securely in CLI.
# WEBEX_ACCESS_TOKEN=
# WEBEX_LOCATION_ID=  # get from --webex-locations

# v0.6 multi-location routing (fixed | prefix | auto)
WEBEX_LOCATION_MODE=prefix
WEBEX_LOCATION_MAPPING=./location-mapping.json
# Keep the same allocation file across batches to avoid duplicate candidate extensions.
WEBEX_ALLOCATION_FILE=./migration-state/extension-allocations.json
# WEBEX_LOCATION_ID is required for fixed mode; optional explicit fallback for prefix.
